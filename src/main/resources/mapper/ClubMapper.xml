<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.club.mapper.ClubMapper">

    <resultMap id="ClubMap" type="com.club.entity.Club">
        <id property="clubId" column="club_id"/>
        <result property="name" column="name"/>
        <result property="categoryId" column="category_id"/>
        <result property="description" column="description"/>
        <result property="charter" column="charter"/>
        <result property="founderId" column="founder_id"/>
        <result property="status" column="status"/>
        <result property="createdAt" column="created_at"/>
    </resultMap>

    <sql id="table_columns">
        club_id,
        name,
        category_id,
        description,
        charter,
        founder_id,
        status,
        created_at
    </sql>

    <select id="getClubList" parameterType="com.club.entity.request.ClubQueryDto" resultMap="ClubMap">
        SELECT
        c.*,
        u.name as founder_name,
        u.email as founder_email,
        cc.name as category_name
        FROM club c
        LEFT JOIN user u ON c.founder_id = u.user_id
        LEFT JOIN club_category cc ON c.category_id = cc.category_id
        <where>
            <!-- 仅筛选需求中的3种状态 -->
            <if test="status != null and status != ''">
                AND c.status = #{status}
            </if>
            <if test="categoryId != null">
                AND c.category_id = #{categoryId}
            </if>
            <if test="founderEmail != null and founderEmail != ''">
                AND u.email LIKE CONCAT('%', #{founderEmail}, '%')
            </if>
        </where>
        ORDER BY c.created_at DESC
    </select>

</mapper>