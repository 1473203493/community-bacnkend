<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.club.mapper.ClubMemberMapper">

    <resultMap id="ClubMemberMap" type="com.club.entity.ClubMember">
        <id property="memberId" column="member_id"/>
        <result property="clubId" column="club_id"/>
        <result property="userId" column="user_id"/>
        <result property="role" column="role"/>
        <result property="joinStatus" column="join_status"/>
        <result property="applyReason" column="apply_reason"/>
        <result property="joinedAt" column="joined_at"/>
    </resultMap>

    <sql id="table_columns">
        member_id,
        club_id,
        user_id,
        role,
        join_status,
        apply_reason,
        joined_at
    </sql>

    <!-- 根据社团ID和用户ID查询成员 -->
    <select id="selectMemberByUserIdAndClubId" resultMap="ClubMemberMap">
        SELECT *
        FROM club_member
        WHERE club_id = #{clubId}
        AND user_id = #{userId}
        AND join_status = '2'  <!-- 只查询已加入的成员 -->
    </select>

    <!-- 查询社团成员列表 -->
    <select id="selectMembersByClubId" resultMap="ClubMemberMap">
        SELECT * FROM club_member
        WHERE club_id = #{clubId}
          AND join_status = '2'
    </select>

    <!-- 调整成员角色 -->
    <update id="updateMemberRole">
        UPDATE club_member
        SET role = #{newRole},
        apply_reason = #{reason},
        joined_at = joined_at  <!-- 维持不变 -->
        WHERE club_id = #{clubId}
        AND user_id = #{userId}
        AND join_status = '2'
    </update>


</mapper>